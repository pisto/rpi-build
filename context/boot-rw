#!/bin/bash

# Reboot into a fully writable, persistent system - and back again.
#
# This image normally boots with "ro systemd.volatile=overlay": the root partition is
# mounted read-only and shadowed by a tmpfs overlay, so every change to / is discarded
# at the next reboot and ext4 never writes to the card. That is deliberately awkward to
# subvert from the running system - the overlay's lower layer is mounted inside the
# initramfs, which is torn down at switch-root, so it is not even in /proc/mounts (only
# /proc/fs/ext4/<dev>/options still reports its state).
#
# So rather than reaching around the overlay, this drops both flags from the kernel
# command line and reboots. The next boot mounts the root partition read-write with no
# overlay, and changes persist. Run `boot-rw revert` to put it back.
#
# /boot is left alone: it is fstab'd read-only, but vfat has no recovery state to
# corrupt and `mount -o remount,rw /boot` works at any time, so it needs no reboot.

set -euo pipefail

[[ ${EUID} -eq 0 ]] || exec sudo -- "$0" "$@"

case "${1:-rw}" in
  rw)     mode=rw ;;
  revert) mode=revert ;;
  *) echo "usage: $(basename "$0") [revert]" 1>&2; exit 1 ;;
esac

# armv7 is booted directly by the RPi firmware from cmdline.txt, while aarch64 boots
# through U-Boot, which builds its command line from boot.txt into a compiled boot.scr
if [[ -f /boot/cmdline.txt ]]; then
  bootfile=/boot/cmdline.txt
  line='^'
elif [[ -f /boot/boot.txt ]]; then
  bootfile=/boot/boot.txt
  line='^setenv bootargs'
else
  echo "Found neither /boot/cmdline.txt nor /boot/boot.txt." 1>&2
  exit 1
fi

current="$(grep "${line}" "${bootfile}")"

# applied only when actually needed: re-running the rw edit would otherwise append a
# second copy of systemd.volatile=overlay to the command line
if [[ ${mode} == rw ]]; then
  [[ ${current} == *systemd.volatile=overlay* ]] || {
    echo "Already configured to boot read-write. Nothing to do."; exit 0; }
else
  [[ ${current} != *systemd.volatile=overlay* ]] || {
    echo "Already configured to boot read-only with a volatile overlay. Nothing to do."; exit 0; }
fi

mount -o remount,rw /boot
if [[ ${mode} == rw ]]; then
  sed -i "/${line}/{s/ ro / rw /;s/ systemd.volatile=overlay//}" "${bootfile}"
else
  sed -i "/${line}/{s/ rw / ro /;s/\$/ systemd.volatile=overlay/}" "${bootfile}"
fi
if [[ ${bootfile} == /boot/boot.txt ]]; then
  (cd /boot && ./mkscr > /dev/null)
fi
sync
mount -o remount,ro /boot

echo "==> Kernel command line is now:"
grep "${line}" "${bootfile}" | sed 's/^/    /'
if [[ ${mode} == rw ]]; then
  echo "==> Rebooting: / will come back writable and persistent."
  echo "    Run 'boot-rw revert' to go back to the read-only volatile root."
else
  echo "==> Rebooting into the read-only volatile root."
fi
exec systemctl reboot
