ARG BASE_IMAGE

FROM $BASE_IMAGE
ARG RPI_ARCH
# use all features of emulated cpu
ENV QEMU_CPU=max

# make / and /boot read only, mount overlayfs on root, 
COPY boot-fdt-fixups.txt /boot
RUN sed -i 's/^ *HOOKS=(\(.*\)) *$/HOOKS=(\1 sd-volatile )/' /etc/mkinitcpio.conf \
  && sed -i 's/ defaults / defaults,ro /' /etc/fstab \
  && sed -i 's/ kms / /;s/ block / /;s/ filesystems / /' /etc/mkinitcpio.conf \
  && if [ "$RPI_ARCH" = armv7 ]; then \
    sed -i 's/ rw / ro /;s/$/ systemd.volatile=overlay/' /boot/cmdline.txt \
    && grep -q ' ro .*systemd.volatile=overlay' /boot/cmdline.txt; \
  else \
    sed -i -e '/^setenv bootargs/{s/ rw / ro /;s/$/ systemd.volatile=overlay/}' \
              -e '\%/dtbs/%r /boot/boot-fdt-fixups.txt' /boot/boot.txt \
    && grep -q '^setenv bootargs.* ro .*systemd.volatile=overlay$' /boot/boot.txt \
    && grep -q 'fdt set /system linux,revision' /boot/boot.txt; \
  fi
COPY boot-rw /usr/local/bin/
RUN chmod 0755 /usr/local/bin/boot-rw

# clock tuning for power save and turb
RUN printf '\n[pi4]\ncore_freq=250\n[all]\n' >> /boot/config.txt \
  && grep -q '^core_freq=250$' /boot/config.txt
RUN printf '\n[pi4]\narm_freq=1800\n[all]\n' >> /boot/config.txt \
  && grep -q '^arm_freq=1800$' /boot/config.txt
# power: scale the cpu on demand instead of pinning it at max, and power down the onboard radios
COPY cpu-governor.conf /etc/tmpfiles.d/
COPY no-wireless.conf /etc/modprobe.d/
COPY rpi-wifi-poweroff /usr/local/bin/
COPY rpi-wifi-poweroff.service /etc/systemd/system/
# the .link Advertise= runs before the PHY is attached, so re-apply it once the link is up
COPY rpi-link-advertise.service /etc/systemd/system/
RUN chmod 0755 /usr/local/bin/rpi-wifi-poweroff \
  && systemctl enable rpi-wifi-poweroff.service \
  && systemctl enable rpi-link-advertise.service
# LEDs off
COPY leds-off.conf /etc/tmpfiles.d/
COPY rpi-leds-quiet.service /etc/systemd/system/
RUN systemctl enable rpi-leds-quiet.service

# entrypoint
RUN systemctl set-default multi-user.target

# boot with dhcp but set my own dns
COPY 10-enu1u1.link 10-end0.link 10-eth0.network /etc/systemd/network/
RUN systemctl disable systemd-networkd-wait-online.service
RUN mkdir -p /etc/systemd/resolved.conf.d
COPY resolved-dns-over-tls.conf /etc/systemd/resolved.conf.d/

# mutable partition
RUN echo '/dev/mmcblk0p3  /mnt/mutable f2fs defaults,nofail,discard 0 0' >> /etc/fstab
# make systemd-timesync almost persistent across reboots
RUN mkdir /var/lib/systemd/timesync \
  && chown systemd-timesync:systemd-timesync /var/lib/systemd/timesync \
  && echo '/mnt/mutable/timesync /var/lib/systemd/timesync none x-systemd.requires=/mnt/mutable,nofail,bind 0 0' >> /etc/fstab
COPY systemd-timesyncd-override.conf /etc/systemd/system/systemd-timesyncd.service.d/override.conf
# mutable /var/log
RUN echo '/mnt/mutable/log /var/log none x-systemd.requires=/mnt/mutable,nofail,bind 0 0' >> /etc/fstab

# dynamic DNS public IP fetcher
COPY ddclient-natpmp-ip /usr/local/bin/
RUN chmod 0755 /usr/local/bin/ddclient-natpmp-ip

# wireguard VPN server
COPY wg0.netdev wg0.network /etc/systemd/network/
RUN chown root:systemd-network /etc/systemd/network/wg0.netdev \
  && chmod 0640 /etc/systemd/network/wg0.netdev
RUN mkdir -p /etc/systemd/networkd.conf.d
COPY networkd-forwarding.conf /etc/systemd/networkd.conf.d/
COPY nftables.conf /etc/nftables.conf
RUN systemctl enable nftables.service

# minecraft servers
RUN mkdir -p /srv/minecraft \
  && echo '/dev/sda4 /srv/minecraft btrfs nofail,noatime,x-systemd.device-timeout=5 0 0' >> /etc/fstab
# swap
RUN echo '/dev/sda5 none swap nofail,x-systemd.device-timeout=5 0 0' >> /etc/fstab \
  && systemctl enable systemd-oomd.service
COPY 99-swappiness.conf /etc/sysctl.d/
# dedicated minecraft slice for system stability
COPY minecraft.slice /etc/systemd/system/
COPY mc-provision-user mc-status-players mc-snapshot mc-restore mc-snapshot-helper /usr/local/bin/
RUN chmod 0755 /usr/local/bin/mc-provision-user /usr/local/bin/mc-status-players \
    /usr/local/bin/mc-snapshot /usr/local/bin/mc-restore /usr/local/bin/mc-snapshot-helper
# polkit authorization for mc-snapshot-helper (no sudo on this image)
COPY com.rpi.mc-snapshot-helper.policy /usr/share/polkit-1/actions/
COPY 49-mc-snapshot.rules /etc/polkit-1/rules.d/
COPY mc-motd.txt /etc/

# next operations are non reproducible (pacman updates), so label when these were ran, invalidate all cached layers below
ARG BUILD_DATE
LABEL org.opencontainers.image.created=$BUILD_DATE

# run a full system upgrade, force reinstall linux kernel to regenrate initramfs, [rpi4] set command line parameters to uboot
RUN --mount=type=cache,id=pacman-$RPI_ARCH,target=/var/cache/pacman/pkg \
    --mount=type=tmpfs,destination=/etc/pacman.d/gnupg \
  mkdir -p /etc/pacman.d/hooks/ && ln -s /dev/null /etc/pacman.d/hooks/90-mkinitcpio-install.hook \
  && pacman-key --init && pacman-key --populate archlinuxarm \
  && pacman -Rs --noconfirm linux-firmware \
  && rm -f /etc/pacman.d/hooks/90-mkinitcpio-install.hook \
  && if [ "$RPI_ARCH" = armv7 ]; then \
    pacman -Sy --noconfirm --disable-sandbox --overwrite '*' linux-rpi; \
  else \
    pacman -Sy --noconfirm --disable-sandbox --overwrite '*' linux-aarch64 uboot-tools \
    && (cd /boot && ./mkscr); \
  fi; \
  pacman -Syu --noconfirm --disable-sandbox --overwrite '*' jdk-openjdk jq ddclient libnatpmp perf wireguard-tools nftables btrfs-progs
