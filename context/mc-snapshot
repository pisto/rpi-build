#!/bin/bash

# Take a backup of your own Minecraft world. Runs as the account itself,
# never as root.
#
# Usage: mc-snapshot [--wait-for-empty]
#   (no flag)         stop the server now and back up immediately
#   --wait-for-empty  used by mc-snapshot.timer: retry every 10m (up to 6x)
#                     until no players are online, then back up - unless
#                     the server hasn't run since the newest snapshot

set -uo pipefail

wait_for_empty=0
for a in "$@"; do
  [[ "${a}" == "--wait-for-empty" ]] && wait_for_empty=1
done

if (( wait_for_empty )); then
  # e.g. right after boot, before the bind mount is up
  mountpoint -q ~/minecraft || {
    logger -t mc-snapshot "~/minecraft is not mounted, skipping"
    exit 1
  }

  # the timer can fire more than once in a day (e.g. a restart or a missed
  # RandomizedDelaySec window on a box with no RTC) - a manual run always
  # takes a fresh snapshot regardless, but the timer path stays a no-op once
  # today's is already done
  shopt -s nullglob
  today=(~/minecraft-snapshots/auto-"$(date +%Y%m%d)"T*)
  if (( ${#today[@]} > 0 )); then
    logger -t mc-snapshot "already have today's snapshot (${today[0]##*/}), skipping"
    exit 0
  fi

  # skip if the server hasn't been started since the newest snapshot. Unit
  # timestamps only cover this user manager's lifetime (i.e. this boot), so
  # a snapshot older than that always gets a successor. Monotonic clocks
  # throughout, since the realtime clock is unreliable early in boot (no RTC)
  latest="$(find ~/minecraft-snapshots -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
    cut -d- -f2 | sort | tail -n1)"
  state="$(systemctl --user show minecraft.service -P ActiveState)"
  if [[ -n "${latest}" && ( "${state}" == inactive || "${state}" == failed ) ]]; then
    snap_real="$(date -d "${latest:0:8} ${latest:9:2}:${latest:11:2}:${latest:13:2}" +%s)"
    read -r uptime _ </proc/uptime
    snap_mono=$(( (snap_real - $(date +%s) + ${uptime%.*}) * 1000000 ))
    manager_mono="$(systemctl show "user@${UID}.service" -P InactiveExitTimestampMonotonic)"
    started_mono="$(systemctl --user show minecraft.service -P InactiveExitTimestampMonotonic)"
    if (( ${manager_mono:-0} > 0 && snap_mono > manager_mono && started_mono < snap_mono )); then
      logger -t mc-snapshot "server not run since ${latest}, skipping today's snapshot"
      exit 0
    fi
  fi

  port="$(awk -F= '/^server-port=/{print $2}' ~/minecraft/server.properties)"
  attempt=1
  max_attempts=6
  while :; do
    out="$(mc-status-players 127.0.0.1 "${port}" 5)"
    rc=$?
    if (( rc == 2 )); then
      break   # nothing listening - definitely empty
    elif (( rc == 0 )); then
      read -r online _ <<<"${out}"
      (( online == 0 )) && break
    fi
    if (( attempt >= max_attempts )); then
      logger -t mc-snapshot "players still online after ${max_attempts} checks (~1h), skipping today's snapshot"
      exit 0
    fi
    logger -t mc-snapshot "players online, waiting 10m (attempt ${attempt}/${max_attempts})"
    sleep 10m
    attempt=$((attempt + 1))
  done
fi

# leave a server that was already stopped stopped
if systemctl --user is-active --quiet minecraft.service; then
  trap 'systemctl --user start minecraft.service' EXIT
  systemctl --user stop minecraft.service
fi
pkexec /usr/local/bin/mc-snapshot-helper snapshot
