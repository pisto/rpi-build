[Unit]
Description=Re-apply LED-off settings once the ethernet PHY is attached
After=systemd-networkd.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/lib/systemd/systemd-networkd-wait-online --interface=eth0 --timeout=60
ExecStart=/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/leds-off.conf

[Install]
WantedBy=multi-user.target
