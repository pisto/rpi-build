#!/bin/sh

set -eu

for type_file in /sys/class/mmc_host/mmc*/mmc*:*/type; do
  [ -r "$type_file" ] || continue
  [ "$(cat "$type_file")" = SDIO ] || continue

  host=${type_file%/mmc*:*/type}
  device=$(dirname "$(dirname "$(readlink -f "$host")")")

  [ -d "$device/driver" ] || continue
  echo "${device##*/}" > "$device/driver/unbind"
  echo "powered down SDIO WiFi host ${device##*/}"
done
